# --- Postgres superuser (used only by docker-compose init scripts to create
#     roles, the audit schema, and seed data — the app never uses this) ---
POSTGRES_DB=governance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser

# --- Connection target (the app connects here) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=governance

# --- Read-only role: SELECT only, used for all introspection/analysis tools ---
DB_READONLY_USER=db_governance_readonly
DB_READONLY_PASSWORD=change_me_readonly

# --- Audit-writer role: INSERT only on audit_log, used only by app/audit.py ---
DB_AUDIT_USER=db_governance_audit_writer
DB_AUDIT_PASSWORD=change_me_audit

# --- Phase 2: local Ollama model for POST /ask tool-selection routing.
#     Must already be pulled (`ollama pull <model>`) and `ollama serve` running. ---
OLLAMA_MODEL=gemma:7b
OLLAMA_HOST=http://localhost:11434
